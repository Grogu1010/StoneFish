# Copy to .env and fill these values locally. Never commit .env or share tokens in chat.
# Begin with CBA_ENV=sandbox. Create ten separate Arena bot identities and sandbox tokens.
CBA_ENV=sandbox

CBA_BOT_TOKEN_V1_SANDBOX=
CBA_BOT_TOKEN_V2_SANDBOX=
CBA_BOT_TOKEN_V3_SANDBOX=
CBA_BOT_TOKEN_V4_SANDBOX=
CBA_BOT_TOKEN_V45_SANDBOX=
CBA_BOT_TOKEN_V5_SANDBOX=
CBA_BOT_TOKEN_V5PRO_SANDBOX=
CBA_BOT_TOKEN_V55_SANDBOX=
CBA_BOT_TOKEN_V55ARTEMIS_SANDBOX=
CBA_BOT_TOKEN_V6_SANDBOX=

# Once each bot has passed Arena evaluation and has its own live token,
# change CBA_ENV=live and fill in these credentials locally.
CBA_BOT_TOKEN_V1_LIVE=
CBA_BOT_TOKEN_V2_LIVE=
CBA_BOT_TOKEN_V3_LIVE=
CBA_BOT_TOKEN_V4_LIVE=
CBA_BOT_TOKEN_V45_LIVE=
CBA_BOT_TOKEN_V5_LIVE=
CBA_BOT_TOKEN_V5PRO_LIVE=
CBA_BOT_TOKEN_V55_LIVE=
CBA_BOT_TOKEN_V55ARTEMIS_LIVE=
CBA_BOT_TOKEN_V6_LIVE=
